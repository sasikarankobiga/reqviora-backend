POSTGRES_DB=reqviora
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-local-password
JWT_KEY=replace-with-a-random-secret-of-at-least-32-characters
ACCOUNTLINKS__BASEURL=https://app.example.com
CORS__ALLOWEDORIGINS__0=https://app.example.com
SMTP__HOST=smtp.example.com
SMTP__PORT=587
SMTP__USERNAME=replace-me
SMTP__PASSWORD=replace-me
SMTP__FROMADDRESS=no-reply@example.com
SMTP__USESSL=true
DATA_PROTECTION_CERTIFICATE_PATH=./secrets/data-protection.pfx
DATA_PROTECTION_CERTIFICATE_PASSWORD=replace-with-a-secret-store-value
AI__APIKEY=replace-me
AI__ENABLED=false
AI__ENDPOINT=https://api.openai.com/v1/
AI__MODEL=gpt-5-mini
AI__TRANSCRIPTIONMODEL=gpt-4o-mini-transcribe
AI__MAXATTEMPTS=3
AI__BASERETRYMILLISECONDS=250
AI__MAXRESPONSECHARACTERS=2000000
MCP__ENABLED=false
STORAGE__ROOTPATH=/var/lib/reqviora/private-artifacts
STORAGE__REQUIREANTIVIRUS=true
STORAGE__CLAMAVHOST=clamav
